# Rename this file to secrets.toml and fill in your Alpaca keys.
# On Streamlit Community Cloud, paste these values into
# App Settings → Secrets instead of using this file.
#
# NEVER commit secrets.toml to GitHub — it contains private keys.

ALPACA_API_KEY    = "your_alpaca_key_id_here"
ALPACA_API_SECRET = "your_alpaca_secret_key_here"
